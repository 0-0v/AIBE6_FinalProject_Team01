{
    "uid": "plamingo-backend",
    "title": "Plamingo Backend",
    "tags": ["plamingo", "performance"],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "10s",
    "time": { "from": "now-15m", "to": "now" },
    "panels": [
        {
            "id": 1,
            "title": "Prometheus 수집 상태 (up)",
            "type": "stat",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
            "fieldConfig": {
                "defaults": {
                    "mappings": [
                        { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
                    ],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            { "value": null, "color": "red" },
                            { "value": 1, "color": "green" }
                        ]
                    }
                },
                "overrides": []
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "up{job=\"plamingo-backend\"}",
                    "datasource": { "type": "prometheus", "uid": "prometheus" }
                }
            ]
        },
        {
            "id": 2,
            "title": "초당 요청 수",
            "type": "timeseries",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 9, "x": 6, "y": 0 },
            "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum(rate(http_server_requests_seconds_count[1m]))",
                    "legendFormat": "req/s",
                    "datasource": { "type": "prometheus", "uid": "prometheus" }
                }
            ]
        },
        {
            "id": 3,
            "title": "서버 오류율 (5xx)",
            "type": "timeseries",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 9, "x": 15, "y": 0 },
            "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[1m])) / sum(rate(http_server_requests_seconds_count[1m]))",
                    "legendFormat": "error rate",
                    "datasource": { "type": "prometheus", "uid": "prometheus" }
                }
            ]
        },
        {
            "id": 4,
            "title": "응답 시간 p95 / p99",
            "type": "timeseries",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
            "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
            "targets": [
                {
                    "refId": "A",
                    "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (le))",
                    "legendFormat": "p95",
                    "datasource": { "type": "prometheus", "uid": "prometheus" }
                },
                {
                    "refId": "B",
                    "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket[5m])) by (le))",
                    "legendFormat": "p99",
                    "datasource": { "type": "prometheus", "uid": "prometheus" }
                }
            ]
        },
        {
            "id": 5,
            "title": "JVM 힙 메모리 사용량",
            "type": "timeseries",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
            "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
            "targets": [
                {
                    "refId": "A",
                    "expr": "jvm_memory_used_bytes{area=\"heap\"}",
                    "legendFormat": "{{id}}",
                    "datasource": { "type": "prometheus", "uid": "prometheus" }
                }
            ]
        }
    ]
}
