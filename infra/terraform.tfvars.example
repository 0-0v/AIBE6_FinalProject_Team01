# 이 파일을 terraform.tfvars로 복사한 뒤 실제 값을 채워 넣습니다.
# terraform.tfvars는 비밀번호를 포함하므로 .gitignore에 의해 커밋되지 않습니다.

key_pair_name    = ""
ssh_allowed_cidr = "" # 예: 1.2.3.4/32

mysql_user           = ""
mysql_password       = ""
mysql_root_password  = ""
redis_password       = ""

npm_admin_email    = ""
npm_admin_password = ""

app_domain           = "" # 예: api.plamingo.example.com (nginx-proxy-manager의 proxy host 도메인과 동일해야 함)
jwt_secret           = ""
google_maps_api_key  = ""

google_client_id     = ""
google_client_secret = ""
kakao_client_id      = ""
kakao_client_secret  = ""
oauth_token_encryption_key = "" # openssl rand -base64 32

brevo_api_key                        = ""
brevo_email_verification_template_id = "1"
brevo_smtp_username                  = "" # 현재 코드에서 실제로는 참조되지 않음(추후 대비용)
brevo_smtp_password                  = "" # 현재 코드에서 실제로는 참조되지 않음(추후 대비용)
brevo_from_email                     = "" # 현재 코드에서 실제로는 참조되지 않음(추후 대비용)

openai_api_key = "" # 없어도 규칙 기반 추천으로 자동 대체
